# Copy to .env to override defaults. .env is gitignored.

# Vault Enterprise (Sentinel, namespaces, control groups):
# VAULT_IMAGE=hashicorp/vault-enterprise:<version>-ent
# VAULT_LICENSE=<license string>

# Include stages 4-5 (k3s) in every `up`; needs rootful Podman, see README.
# COMPOSE_PROFILES=k8s

# Change these to run two demos at the same time.
# RUNNER_PORT=8080
# VAULT_PORT=8200
